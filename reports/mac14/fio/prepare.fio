[global]
ioengine=io_uring
direct=1
thread=1
iodepth=32
invalidate=0
numjobs=1
size=32G
filename=${NDS_TEST_DIRECTORY}/nvme-read-only-test.bin
cpus_allowed=192-195
cpus_allowed_policy=split
percentile_list=50:95:99
lat_percentiles=1
rw=write
bs=1M
verify=crc32c
do_verify=1
verify_fatal=1
refill_buffers=1
end_fsync=1
[prepare]
